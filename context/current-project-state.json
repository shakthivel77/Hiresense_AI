  "coreAlgorithms": {
    "hiresenseCompetencyScore": "S_composite = 0.40 * S_mastery + 0.20 * S_difficulty + 0.15 * S_coverage + 0.15 * S_project + 0.10 * S_interview",
    "skillVerificationThreshold": "Passing score >= 80.0% enforced server-side",
    "attemptLimitRule": "Maximum 3 completed attempts per skill per calendar month (UTC)",
    "integrityPenalty": "Score = max(0, 100 - (10*tabSwitches + 15*fullscreenExits + 5*clipboardViolations)). Disqualify if tabSwitches > 3 OR score < 60",
    "cryptographicProofSignature": "HMAC-SHA256(userId + ':' + skillId + ':' + score + ':' + attemptId + ':' + verificationDate, PROOF_SECRET_KEY)",
    "jobCompatibilityScore": "Sum of weights of matched verified skills / Sum of weights of all required/preferred job skills * 100",
    "dagTopologicalSort": "Kahn's Algorithm / DFS cycle validation & prerequisite ancestor resolution"
  },
